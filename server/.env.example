# Copy to .env only on the computer running the local server.
# Never put this file's real values in the mobile app or Git.
# Either an API base URL ending in /v1 or a full /chat/completions endpoint.
LINGONEST_AI_BASE_URL=
LINGONEST_AI_API_KEY=
LINGONEST_AI_MODEL=
# Optional Merriam-Webster Learner's Dictionary key. Keep this only on the computer.
LINGONEST_WEBSTER_KEY=
# Usually leave this unset: the Learner's Dictionary endpoint is built in.
# LINGONEST_WEBSTER_BASE_URL=https://www.dictionaryapi.com/api/v3/references/learners/json
# 5.1b only: enable after the 5.1c mobile account client is ready.
# Requires LINGONEST_LAN_IP, LINGONEST_LAN_BACKUP=1 and LINGONEST_LAN_TLS=1.
# LINGONEST_ACCOUNTS=1
